# e-Samanvit backend — copy to ".env" for local development.
# No secrets belong in this file at this stage — government API
# credentials are explicitly out of scope until a later prompt.

PORT=5000
NODE_ENV=development

# The one canonical frontend origin (see src/middleware/cors.js). In
# production this is the production Vercel URL, e.g.
# FRONTEND_ORIGIN=https://e-samanvit.vercel.app
# Vercel's own per-deployment preview URLs (https://e-samanvit-*.vercel.app)
# are allowed automatically based on this value — they do not need to be
# (and should not be) added here as extra origins.
FRONTEND_ORIGIN=http://localhost:5173

# Resend (https://resend.com) — used to email "Contact Us" form
# submissions from the frontend. Not wired to a backend route yet;
# these are the variable names that route will read once added.
# Get RESEND_API_KEY from the Resend dashboard — never commit the
# real value, only ever put it in your local/deployment .env.
RESEND_API_KEY=re_your_resend_api_key_here
# The verified "from" address Resend sends as (must be on a domain
# you've verified with Resend, or their default onboarding domain).
CONTACT_FROM_EMAIL=e-samanvit@yourdomain.com
# Where "Contact Us" messages should be delivered.
CONTACT_TO_EMAIL=support@yourdomain.com

# data.gov.in (Open Government Data Platform) — OPTIONAL secondary
# source for pincode -> address enrichment, tried only if the always-
# free India Post Pincode API fails. Leave blank to skip this tier
# entirely (falls straight through to bundled mock data instead).
# Sign up + get a key at https://data.gov.in ("My Account" -> "API Keys").
DATA_GOV_IN_API_KEY=
# The resource_id of the specific dataset you're querying (e.g. the
# "All India Pincode Directory" resource) — found on that dataset's
# own data.gov.in page.
DATA_GOV_IN_PINCODE_RESOURCE_ID=

# Setu (https://setu.co) — OPTIONAL. A licensed DigiLocker Requesting
# Partner that resells sandbox/production DigiLocker access, used by
# the Revenue adapter to fetch Income/Caste/Domicile certificates once
# a citizen completes real DigiLocker consent. Leave blank to keep the
# Revenue adapter fully on its mock demo record.
# Credentials are issued by Setu directly (docs.setu.co/data/digilocker)
# — not instant self-serve, expect a short onboarding conversation.
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
# "sandbox" (default) or "production" — controls which Setu base URL is used.
SETU_ENV=sandbox

# Google Gemini (https://ai.google.dev) — OPTIONAL. Used only by MITRA
# (the citizen chat assistant) for free-text questions its own local,
# already-working knowledge base doesn't match. Leave blank to keep
# MITRA fully on its existing scripted/localized (English/Hindi/Marathi)
# responses — nothing about MITRA's current behavior depends on this.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional — defaults to gemini-2.5-flash if left blank (the current
# safest free-tier choice; gemini-2.0-flash has been reported returning
# 0-quota errors on new free-tier projects in 2026). Change this if
# Google renames/retires that model rather than editing code.
GEMINI_MODEL=
